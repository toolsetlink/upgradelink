syntax = "v1"

info(
    title: "API management"
    desc: "API management is used to register APIs and manage APIs"
    author: "toolsetlink"
    email: "toolsetlink@163.com"
    version: "v1.0"
)

import "../base.api"

type (

    GetApkUpgradeInfoReq {
        // Apk 应用 唯一标识
        ApkKey string `json:"apkKey"`

        // 客户端应用版本号
        VersionCode int64 `json:"versionCode"`

        // 升级指定版本（可空，为空时是最新版本）
        AppointVersionCode int64 `json:"appointVersionCode,default=0"`

        // 设备机型唯一标识
        DevModelKey string `json:"devModelKey,optional"`

        // 设备唯一标识
        DevKey string `json:"devKey,optional"`

        // 差分算法 0：默认值 不使用差分算法 1：HDiffPatch; 2：bsdiff;
        PatchAlgo int64 `json:"patchAlgo,default=0"`
    }

    GetApkUpgradeInfoResp {
        BaseDataInfo

        Data GetApkUpgradeInfoRespData `json:"data"`
    }

    GetApkUpgradeInfoRespData {

        // apk 应用 唯一标识
        ApkKey string `json:"apkKey,optional"`

        // 应用包名
        PackageName string `json:"packageName,optional"`

        // 客户端应用版本名称
        VersionName string `json:"versionName,optional"`

        // 应用版本号
        VersionCode int64 `json:"versionCode,optional"`

        // 最新版本下载地址
        UrlPath string `json:"urlPath,optional"`

        // 文件 大小
        UrlFileSize uint64 `json:"urlFileSize,optional"`

        // 文件 Md5
        UrlFileMd5 string `json:"urlFileMd5,optional"`

        // 差分包算法 0:默认值，无差分包; 1 HDiffPatch;2 bsdiff;
        PatchAlgo int64 `json:"patchAlgo,optional"`

        // 差分包下载地址
        PatchUrlPath string `json:"patchUrlPath,optional"`

        // 差分包 大小
        PatchUrlFileSize uint64 `json:"patchUrlFileSize,optional"`

        // 差分包 Md5
        PatchUrlFileMd5 string `json:"patchUrlFileMd5,optional"`

        // 升级类型 0：未知方式；1：提示升级；2：静默升级；3: 强制升级
        UpgradeType int64 `json:"upgradeType,optional"`

        // 提示升级描述内容
        PromptUpgradeContent string `json:"promptUpgradeContent,optional"`
    }

)



type GetApkVersionInfoRespData {

    // apk 应用 唯一标识
    ApkKey string `json:"apkKey,optional"`

    // 应用包名
    PackageName string `json:"packageName,optional"`

    // 客户端应用版本名称
    VersionName string `json:"versionName,optional"`

    // 应用版本号
    VersionCode int64 `json:"versionCode,optional"`

    // 描述
    Description string `json:"description,optional"`
}

type (

    GetApkVersionInfoReq {
        // Apk 应用 唯一标识
        ApkKey string `json:"apkKey"`

        // 客户端应用版本号
        VersionCode int64 `json:"versionCode"`
    }

    GetApkVersionInfoResp {
        BaseDataInfo

        Data GetApkVersionInfoRespData `json:"data"`
    }
)

// RateLimit 流量控制
// ReplayAttack 防重放攻击
// Signature 签名认证
@server(
    prefix: /v1/apk
    group: apk
    timeout: 30s
    middleware: RateLimit, ReplayAttack, Signature
)
service api {
    // Get API list | 获取升级任务
    @handler getApkUpgradeInfo
    post /upgrade (GetApkUpgradeInfoReq) returns (GetApkUpgradeInfoResp)

    // 获取 版本信息
    @handler getApkVersionInfo
    post /version (GetApkVersionInfoReq) returns (GetApkVersionInfoResp)
}

type (
    GetApkDownloadInfoReq {
        // 下载类型， 1: 下载安装版本，2: 下载差分文件
        DownloadType int64 `form:"downloadType,default=1"`
        // apk 应用 唯一标识
        ApkKey string `form:"apkKey"`
        // 指定版本（可空，为空时是最新版本）
        VersionCode int64 `form:"versionCode,optional,default=0"`
        // cloud 文件 唯一标识
        CloudFileId string `form:"cloudFileId,optional,default=''"`
    }
)

// RateLimit 流量控制
@server(
    group: download
    prefix: /v1/apk
    timeout: 30s
    middleware: CdnRateLimit
)
service api {
    @handler getApkDownloadInfo
    get /download (GetApkDownloadInfoReq) returns (string)
}
